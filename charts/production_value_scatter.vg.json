{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Does producing more mean earning more?",
    "fontSize": 20,
    "anchor": "start",
    "offset": 15,
    "font": "Arial"
  },
  "width": 720,
  "height": 410,
  "data": {
    "url": "https://ohnyengern.github.io/australian-fruit-dashboard-/data/fruit_production_value.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "calculate": "toNumber(datum.ProductionTonnes)",
      "as": "ProductionTonnesNum"
    },
    {
      "calculate": "toNumber(datum.ProductionValueM)",
      "as": "ProductionValueMNum"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 180,
        "opacity": 0.9,
        "stroke": "#ffffff",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "ProductionTonnesNum",
          "type": "quantitative",
          "title": "Production volume (tonnes)",
          "scale": {
            "domain": [
              0,
              600000
            ]
          },
          "axis": {
            "format": ",.0f",
            "grid": true
          }
        },
        "y": {
          "field": "ProductionValueMNum",
          "type": "quantitative",
          "title": "Production value ($ million)",
          "scale": {
            "domain": [
              0,
              900
            ]
          },
          "axis": {
            "format": ",.0f",
            "grid": true
          }
        },
        "color": {
          "field": "Fruit",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Apple",
              "Avocado",
              "Banana",
              "Blueberry",
              "Mandarin",
              "Orange",
              "Strawberry",
              "Table grapes"
            ],
            "range": [
              "#4c78a8",
              "#f58518",
              "#A59837",
              "#72b7b2",
              "#54a24b",
              "#B17B00",
              "#b279a2",
              "#D67387"
            ]
          }
        },
        "tooltip": [
          {
            "field": "Fruit",
            "type": "nominal",
            "title": "Fruit:"
          },
          {
            "field": "ProductionTonnesNum",
            "type": "quantitative",
            "title": "Production volume (tonnes):",
            "format": ",.0f"
          },
          {
            "field": "ProductionValueMNum",
            "type": "quantitative",
            "title": "Production value ($m):",
            "format": ",.1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "normal",
        "color": "#333333",
        "align": {
          "expr": "datum.Fruit == 'Orange' ? 'right' : datum.Fruit == 'Blueberry' || datum.Fruit == 'Strawberry' ? (width < 650 ? 'left' : 'center') : 'left'"
        },
        "baseline": {
          "expr": "datum.Fruit == 'Blueberry' || datum.Fruit == 'Orange' ? 'bottom' : datum.Fruit == 'Strawberry' ? 'top' : 'middle'"
        },
        "font": "Arial",
        "dx": {
          "expr": "datum.Fruit == 'Orange' ? -14 : datum.Fruit == 'Blueberry' || datum.Fruit == 'Strawberry' ? 0 : 14"
        },
        "dy": {
          "expr": "datum.Fruit == 'Blueberry' || datum.Fruit == 'Orange' ? -13 : datum.Fruit == 'Strawberry' ? 13 : 0"
        }
      },
      "encoding": {
        "x": {
          "field": "ProductionTonnesNum",
          "type": "quantitative"
        },
        "y": {
          "field": "ProductionValueMNum",
          "type": "quantitative"
        },
        "text": {
          "field": "Fruit",
          "type": "nominal"
        }
      },
      "name": "fruitPointLabels"
    },
    {
      "data": {
        "values": [
          {
            "x": 212000,
            "y": 860,
            "x2": 228882,
            "y2": 874.9
          }
        ]
      },
      "mark": {
        "type": "rule",
        "stroke": "#333333",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "x2": {
          "field": "x2"
        },
        "y2": {
          "field": "y2"
        }
      },
      "name": "grapeAnnotationLeader"
    },
    {
      "data": {
        "values": [
          {
            "x": 210000,
            "y": 800,
            "label": [
              "Highest production value despite",
              "a relatively smaller harvest"
            ]
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "fontSize": 12,
        "color": "#333333",
        "font": "Arial"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      },
      "name": "grapeAnnotationText"
    },
    {
      "data": {
        "values": [
          {
            "x": 548000,
            "y": 435,
            "x2": 572540,
            "y2": 541.8
          }
        ]
      },
      "mark": {
        "type": "rule",
        "stroke": "#333333",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "x2": {
          "field": "x2"
        },
        "y2": {
          "field": "y2"
        }
      },
      "name": "orangeAnnotationLeader"
    },
    {
      "data": {
        "values": [
          {
            "x": 465000,
            "y": 420,
            "label": [
              "High production volume,",
              "but relatively low",
              "production value"
            ]
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 12,
        "color": "#333333",
        "font": "Arial"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      },
      "name": "orangeAnnotationText"
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 12,
      "titleFontSize": 13
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 12,
      "titleFontSize": 15
    },
    "header": {
      "labelFont": "Arial",
      "titleFont": "Arial"
    }
  }
}
