{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Change in fruit production between 2021 and 2025",
    "fontSize": 20,
    "anchor": "start",
    "offset": 15,
    "font": "Arial"
  },
  "data": {
    "url": "https://ohnyengern.github.io/australian-fruit-dashboard-/data/abs_fruit_production.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "calculate": "toNumber(datum['2021'])",
      "as": "StartProduction"
    },
    {
      "calculate": "toNumber(datum['2025'])",
      "as": "EndProduction"
    },
    {
      "calculate": "((datum.EndProduction - datum.StartProduction) / datum.StartProduction) * 100",
      "as": "GrowthPct"
    },
    {
      "fold": [
        "StartProduction",
        "EndProduction"
      ],
      "as": [
        "PeriodField",
        "Production"
      ]
    },
    {
      "calculate": "datum.PeriodField == 'StartProduction' ? '2021' : '2025'",
      "as": "Period"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "Period",
          "type": "ordinal",
          "title": null,
          "sort": [
            "2021",
            "2025"
          ],
          "axis": {
            "labelAngle": 0,
            "labelFontSize": 12,
            "labelFontWeight": "bold",
            "ticks": false,
            "domain": false
          }
        },
        "y": {
          "field": "Production",
          "type": "quantitative",
          "title": "Production (tonnes)",
          "axis": {
            "format": "~s",
            "gridColor": "#e6e6e6",
            "gridOpacity": 0.7,
            "titlePadding": 12
          }
        },
        "color": {
          "field": "Fruit",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Apple",
              "Avocado",
              "Banana",
              "Blueberry",
              "Mandarin",
              "Orange",
              "Strawberry",
              "Table grapes"
            ],
            "range": [
              "#4c78a8",
              "#f58518",
              "#A59837",
              "#72b7b2",
              "#54a24b",
              "#eeca3b",
              "#b279a2",
              "#ff9da6"
            ]
          }
        },
        "detail": {
          "field": "Fruit"
        },
        "tooltip": [
          {
            "field": "Fruit",
            "type": "nominal",
            "title": "Fruit:"
          },
          {
            "field": "Period",
            "type": "ordinal",
            "title": "Year ending June:"
          },
          {
            "field": "Production",
            "type": "quantitative",
            "title": "Production (tonnes):",
            "format": ","
          },
          {
            "field": "GrowthPct",
            "type": "quantitative",
            "title": "Overall change (%):",
            "format": "+.1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 80
      },
      "encoding": {
        "x": {
          "field": "Period",
          "type": "ordinal",
          "sort": [
            "2021",
            "2025"
          ]
        },
        "y": {
          "field": "Production",
          "type": "quantitative"
        },
        "color": {
          "field": "Fruit",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Apple",
              "Avocado",
              "Banana",
              "Blueberry",
              "Mandarin",
              "Orange",
              "Strawberry",
              "Table grapes"
            ],
            "range": [
              "#4c78a8",
              "#f58518",
              "#A59837",
              "#72b7b2",
              "#54a24b",
              "#eeca3b",
              "#b279a2",
              "#ff9da6"
            ]
          }
        },
        "tooltip": [
          {
            "field": "Fruit",
            "type": "nominal",
            "title": "Fruit:"
          },
          {
            "field": "Period",
            "type": "ordinal",
            "title": "Year ending June:"
          },
          {
            "field": "Production",
            "type": "quantitative",
            "title": "Production (tonnes):",
            "format": ","
          },
          {
            "field": "GrowthPct",
            "type": "quantitative",
            "title": "Overall change (%):",
            "format": "+.1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Period == '2025' && datum.Fruit != 'Mandarin' && datum.Fruit != 'Table grapes'"
        },
        {
          "calculate": "datum.Fruit + '  ' + format(datum.GrowthPct, '+.1f') + '%'",
          "as": "EndLabel"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 10,
        "fontSize": 12,
        "font": "Arial"
      },
      "encoding": {
        "x": {
          "field": "Period",
          "type": "ordinal",
          "sort": [
            "2021",
            "2025"
          ]
        },
        "y": {
          "field": "Production",
          "type": "quantitative"
        },
        "text": {
          "field": "EndLabel"
        },
        "color": {
          "field": "Fruit",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Apple",
              "Avocado",
              "Banana",
              "Blueberry",
              "Mandarin",
              "Orange",
              "Strawberry",
              "Table grapes"
            ],
            "range": [
              "#4c78a8",
              "#f58518",
              "#A59837",
              "#72b7b2",
              "#54a24b",
              "#eeca3b",
              "#b279a2",
              "#ff9da6"
            ]
          }
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Period == '2025' && datum.Fruit == 'Mandarin'"
        },
        {
          "calculate": "datum.Fruit + '  ' + format(datum.GrowthPct, '+.1f') + '%'",
          "as": "EndLabel"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 10,
        "dy": -10,
        "fontSize": 12,
        "font": "Arial"
      },
      "encoding": {
        "x": {
          "field": "Period",
          "type": "ordinal",
          "sort": [
            "2021",
            "2025"
          ]
        },
        "y": {
          "field": "Production",
          "type": "quantitative"
        },
        "text": {
          "field": "EndLabel"
        },
        "color": {
          "field": "Fruit",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Apple",
              "Avocado",
              "Banana",
              "Blueberry",
              "Mandarin",
              "Orange",
              "Strawberry",
              "Table grapes"
            ],
            "range": [
              "#4c78a8",
              "#f58518",
              "#A59837",
              "#72b7b2",
              "#54a24b",
              "#eeca3b",
              "#b279a2",
              "#ff9da6"
            ]
          }
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Period == '2025' && datum.Fruit == 'Table grapes'"
        },
        {
          "calculate": "datum.Fruit + '  ' + format(datum.GrowthPct, '+.1f') + '%'",
          "as": "EndLabel"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 10,
        "dy": 3,
        "fontSize": 12,
        "font": "Arial"
      },
      "encoding": {
        "x": {
          "field": "Period",
          "type": "ordinal",
          "sort": [
            "2021",
            "2025"
          ]
        },
        "y": {
          "field": "Production",
          "type": "quantitative"
        },
        "text": {
          "field": "EndLabel"
        },
        "color": {
          "field": "Fruit",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Apple",
              "Avocado",
              "Banana",
              "Blueberry",
              "Mandarin",
              "Orange",
              "Strawberry",
              "Table grapes"
            ],
            "range": [
              "#4c78a8",
              "#f58518",
              "#A59837",
              "#72b7b2",
              "#54a24b",
              "#eeca3b",
              "#b279a2",
              "#ff9da6"
            ]
          }
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Period == '2021' && (datum.Fruit == 'Mandarin' || datum.Fruit == 'Table grapes')"
        },
        {
          "calculate": "datum.Fruit == 'Mandarin' ? datum.StartProduction : null",
          "as": "MandarinStart"
        },
        {
          "calculate": "datum.Fruit == 'Mandarin' ? datum.EndProduction : null",
          "as": "MandarinEnd"
        },
        {
          "calculate": "datum.Fruit == 'Table grapes' ? datum.StartProduction : null",
          "as": "GrapeStart"
        },
        {
          "calculate": "datum.Fruit == 'Table grapes' ? datum.EndProduction : null",
          "as": "GrapeEnd"
        },
        {
          "aggregate": [
            {
              "op": "max",
              "field": "MandarinStart",
              "as": "MandarinStart"
            },
            {
              "op": "max",
              "field": "MandarinEnd",
              "as": "MandarinEnd"
            },
            {
              "op": "max",
              "field": "GrapeStart",
              "as": "GrapeStart"
            },
            {
              "op": "max",
              "field": "GrapeEnd",
              "as": "GrapeEnd"
            }
          ]
        },
        {
          "calculate": "(datum.GrapeStart - datum.MandarinStart) / ((datum.MandarinEnd - datum.MandarinStart) - (datum.GrapeEnd - datum.GrapeStart))",
          "as": "CrossFraction"
        },
        {
          "calculate": "datum.MandarinStart + datum.CrossFraction * (datum.MandarinEnd - datum.MandarinStart)",
          "as": "CrossProduction"
        }
      ],
      "mark": {
        "type": "rule",
        "stroke": "#666666",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "scale('x', '2021') + bandwidth('x') / 2 + (scale('x', '2025') - scale('x', '2021')) * datum.CrossFraction"
          }
        },
        "x2": {
          "value": {
            "expr": "(scale('x', '2021') + bandwidth('x') / 2 + (scale('x', '2025') - scale('x', '2021')) * datum.CrossFraction) - 35"
          }
        },
        "y": {
          "field": "CrossProduction",
          "type": "quantitative"
        },
        "y2": {
          "datum": 180000
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Period == '2021' && (datum.Fruit == 'Mandarin' || datum.Fruit == 'Table grapes')"
        },
        {
          "calculate": "datum.Fruit == 'Mandarin' ? datum.StartProduction : null",
          "as": "MandarinStart"
        },
        {
          "calculate": "datum.Fruit == 'Mandarin' ? datum.EndProduction : null",
          "as": "MandarinEnd"
        },
        {
          "calculate": "datum.Fruit == 'Table grapes' ? datum.StartProduction : null",
          "as": "GrapeStart"
        },
        {
          "calculate": "datum.Fruit == 'Table grapes' ? datum.EndProduction : null",
          "as": "GrapeEnd"
        },
        {
          "aggregate": [
            {
              "op": "max",
              "field": "MandarinStart",
              "as": "MandarinStart"
            },
            {
              "op": "max",
              "field": "MandarinEnd",
              "as": "MandarinEnd"
            },
            {
              "op": "max",
              "field": "GrapeStart",
              "as": "GrapeStart"
            },
            {
              "op": "max",
              "field": "GrapeEnd",
              "as": "GrapeEnd"
            }
          ]
        },
        {
          "calculate": "(datum.GrapeStart - datum.MandarinStart) / ((datum.MandarinEnd - datum.MandarinStart) - (datum.GrapeEnd - datum.GrapeStart))",
          "as": "CrossFraction"
        },
        {
          "calculate": "datum.MandarinStart + datum.CrossFraction * (datum.MandarinEnd - datum.MandarinStart)",
          "as": "CrossProduction"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 12,
        "color": "#333333",
        "font": "Arial"
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "(scale('x', '2021') + bandwidth('x') / 2 + (scale('x', '2025') - scale('x', '2021')) * datum.CrossFraction) - 35"
          }
        },
        "y": {
          "datum": 164000,
          "type": "quantitative"
        },
        "text": {
          "value": "Mandarins first moved ahead in 2024;"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Period == '2021' && (datum.Fruit == 'Mandarin' || datum.Fruit == 'Table grapes')"
        },
        {
          "calculate": "datum.Fruit == 'Mandarin' ? datum.StartProduction : null",
          "as": "MandarinStart"
        },
        {
          "calculate": "datum.Fruit == 'Mandarin' ? datum.EndProduction : null",
          "as": "MandarinEnd"
        },
        {
          "calculate": "datum.Fruit == 'Table grapes' ? datum.StartProduction : null",
          "as": "GrapeStart"
        },
        {
          "calculate": "datum.Fruit == 'Table grapes' ? datum.EndProduction : null",
          "as": "GrapeEnd"
        },
        {
          "aggregate": [
            {
              "op": "max",
              "field": "MandarinStart",
              "as": "MandarinStart"
            },
            {
              "op": "max",
              "field": "MandarinEnd",
              "as": "MandarinEnd"
            },
            {
              "op": "max",
              "field": "GrapeStart",
              "as": "GrapeStart"
            },
            {
              "op": "max",
              "field": "GrapeEnd",
              "as": "GrapeEnd"
            }
          ]
        },
        {
          "calculate": "(datum.GrapeStart - datum.MandarinStart) / ((datum.MandarinEnd - datum.MandarinStart) - (datum.GrapeEnd - datum.GrapeStart))",
          "as": "CrossFraction"
        },
        {
          "calculate": "datum.MandarinStart + datum.CrossFraction * (datum.MandarinEnd - datum.MandarinStart)",
          "as": "CrossProduction"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 12,
        "color": "#333333",
        "font": "Arial"
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "(scale('x', '2021') + bandwidth('x') / 2 + (scale('x', '2025') - scale('x', '2021')) * datum.CrossFraction) - 35"
          }
        },
        "y": {
          "datum": 140000,
          "type": "quantitative"
        },
        "text": {
          "value": "their lead reached 11,604 tonnes in 2025."
        }
      }
    }
  ],
  "width": 720,
  "height": 370,
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "labelColor": "#444444",
      "titleColor": "#222222",
      "domainColor": "#999999",
      "tickColor": "#999999",
      "labelFont": "Arial",
      "titleFont": "Arial"
    },
    "font": "Arial",
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 12,
      "titleFontSize": 15
    },
    "header": {
      "labelFont": "Arial",
      "titleFont": "Arial"
    }
  }
}
