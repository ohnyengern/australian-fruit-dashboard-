{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Australian Fruit Production Growth from 2020–21 to 2024–25",
    "fontSize": 20,
    "anchor": "start",
    "offset": 15,
    "font": "Arial"
  },
  "data": {
    "url": "https://ohnyengern.github.io/australian-fruit-dashboard-/data/abs_fruit_production.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "calculate": "toNumber(datum['2020–21'])",
      "as": "StartProduction"
    },
    {
      "calculate": "toNumber(datum['2024–25'])",
      "as": "EndProduction"
    },
    {
      "calculate": "((datum.EndProduction - datum.StartProduction) / datum.StartProduction) * 100",
      "as": "GrowthPct"
    },
    {
      "fold": [
        "StartProduction",
        "EndProduction"
      ],
      "as": [
        "PeriodField",
        "Production"
      ]
    },
    {
      "calculate": "datum.PeriodField == 'StartProduction' ? '2020–21' : '2024–25'",
      "as": "Period"
    },
    {
      "calculate": "datum.PeriodField == 'StartProduction' ? 0 : datum.GrowthPct",
      "as": "ChangeFromBaseline"
    }
  ],
  "layer": [
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "rule",
        "stroke": "#888888",
        "strokeWidth": 1,
        "strokeDash": [
          4,
          4
        ]
      },
      "encoding": {
        "y": {
          "datum": 0,
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "line"
      },
      "encoding": {
        "x": {
          "field": "Period",
          "type": "ordinal",
          "title": "Year",
          "sort": [
            "2020–21",
            "2024–25"
          ],
          "axis": {
            "labelAngle": 0,
            "labelFontSize": 12,
            "labelFontWeight": 400,
            "ticks": false,
            "domain": true,
            "titlePadding": 12
          }
        },
        "y": {
          "field": "ChangeFromBaseline",
          "type": "quantitative",
          "title": "Change in production (%)",
          "axis": {
            "gridColor": "#e6e6e6",
            "gridOpacity": 0.7,
            "titlePadding": 12,
            "labelExpr": "format(datum.value, '.0f') + '%'",
            "grid": true,
            "values": [
              -20,
              -10,
              0,
              10,
              20,
              30,
              40,
              50,
              60,
              70,
              80
            ]
          },
          "scale": {
            "domain": [
              -20,
              80
            ],
            "zero": false
          }
        },
        "color": {
          "field": "Fruit",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Apple",
              "Avocado",
              "Banana",
              "Blueberry",
              "Mandarin",
              "Orange",
              "Strawberry",
              "Table grapes"
            ],
            "range": [
              "#4c78a8",
              "#f58518",
              "#A59837",
              "#72b7b2",
              "#54a24b",
              "#E0A900",
              "#b279a2",
              "#E04488"
            ]
          }
        },
        "detail": {
          "field": "Fruit"
        },
        "tooltip": [
          {
            "field": "Fruit",
            "type": "nominal",
            "title": "Fruit:"
          },
          {
            "field": "Period",
            "type": "nominal",
            "title": "Year:"
          },
          {
            "field": "Production",
            "type": "quantitative",
            "title": "Production (tonnes):",
            "format": ","
          },
          {
            "field": "ChangeFromBaseline",
            "type": "quantitative",
            "title": "Change from 2020–21 (%):",
            "format": "+.1f"
          }
        ],
        "opacity": {
          "condition": {
            "param": "FruitHighlight",
            "value": 1
          },
          "value": 0.12
        },
        "strokeWidth": {
          "condition": {
            "param": "FruitHighlight",
            "empty": false,
            "value": 4
          },
          "value": 2
        }
      },
      "params": [
        {
          "name": "FruitHighlight",
          "select": {
            "type": "point",
            "fields": [
              "Fruit"
            ],
            "on": {
              "type": "pointerover",
              "filter": [
                "event.item && event.item.datum && event.item.datum.Fruit"
              ]
            },
            "clear": "pointerout"
          }
        }
      ]
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 80
      },
      "encoding": {
        "x": {
          "field": "Period",
          "type": "ordinal",
          "sort": [
            "2020–21",
            "2024–25"
          ],
          "title": "Year",
          "axis": {
            "labelAngle": 0
          }
        },
        "y": {
          "field": "ChangeFromBaseline",
          "type": "quantitative"
        },
        "color": {
          "field": "Fruit",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Apple",
              "Avocado",
              "Banana",
              "Blueberry",
              "Mandarin",
              "Orange",
              "Strawberry",
              "Table grapes"
            ],
            "range": [
              "#4c78a8",
              "#f58518",
              "#A59837",
              "#72b7b2",
              "#54a24b",
              "#E0A900",
              "#b279a2",
              "#E04488"
            ]
          }
        },
        "tooltip": [
          {
            "field": "Fruit",
            "type": "nominal",
            "title": "Fruit:"
          },
          {
            "field": "Period",
            "type": "nominal",
            "title": "Year:"
          },
          {
            "field": "Production",
            "type": "quantitative",
            "title": "Production (tonnes):",
            "format": ","
          },
          {
            "field": "ChangeFromBaseline",
            "type": "quantitative",
            "title": "Change from 2020–21 (%):",
            "format": "+.1f"
          }
        ],
        "opacity": {
          "condition": {
            "param": "FruitHighlight",
            "value": 1
          },
          "value": 0.12
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Period == '2024–25' && datum.Fruit != 'Blueberry'"
        },
        {
          "calculate": "datum.Fruit + '  ' + format(datum.GrowthPct, '+.1f') + '%'",
          "as": "EndLabel"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 10,
        "fontSize": 12,
        "font": "Arial",
        "dy": {
          "expr": "datum.Fruit === 'Strawberry' ? 14 : datum.Fruit === 'Banana' ? 4 : 0"
        }
      },
      "encoding": {
        "x": {
          "field": "Period",
          "type": "ordinal",
          "sort": [
            "2020–21",
            "2024–25"
          ],
          "title": "Year",
          "axis": {
            "labelAngle": 0
          }
        },
        "y": {
          "field": "ChangeFromBaseline",
          "type": "quantitative"
        },
        "text": {
          "field": "EndLabel"
        },
        "color": {
          "field": "Fruit",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Apple",
              "Avocado",
              "Banana",
              "Blueberry",
              "Mandarin",
              "Orange",
              "Strawberry",
              "Table grapes"
            ],
            "range": [
              "#4c78a8",
              "#f58518",
              "#A59837",
              "#72b7b2",
              "#54a24b",
              "#E0A900",
              "#b279a2",
              "#E04488"
            ]
          },
          "condition": {
            "test": "datum.Fruit === 'Orange'",
            "value": "#E0A900"
          }
        },
        "opacity": {
          "condition": {
            "param": "FruitHighlight",
            "value": 1
          },
          "value": 0.12
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Period == '2024–25' && datum.Fruit == 'Blueberry'"
        },
        {
          "calculate": "datum.Fruit + '  ' + format(datum.GrowthPct, '+.1f') + '%'",
          "as": "EndLabel"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 10,
        "dy": -26,
        "fontSize": 12,
        "font": "Arial"
      },
      "encoding": {
        "x": {
          "field": "Period",
          "type": "ordinal",
          "sort": [
            "2020–21",
            "2024–25"
          ],
          "title": "Year",
          "axis": {
            "labelAngle": 0
          }
        },
        "y": {
          "field": "ChangeFromBaseline",
          "type": "quantitative"
        },
        "text": {
          "field": "EndLabel"
        },
        "color": {
          "field": "Fruit",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Apple",
              "Avocado",
              "Banana",
              "Blueberry",
              "Mandarin",
              "Orange",
              "Strawberry",
              "Table grapes"
            ],
            "range": [
              "#4c78a8",
              "#f58518",
              "#A59837",
              "#72b7b2",
              "#54a24b",
              "#E0A900",
              "#b279a2",
              "#E04488"
            ]
          },
          "condition": {
            "test": "datum.Fruit === 'Orange'",
            "value": "#E0A900"
          }
        },
        "opacity": {
          "condition": {
            "param": "FruitHighlight",
            "value": 1
          },
          "value": 0.12
        }
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "encoding": {
        "x": {
          "datum": "2024–25",
          "type": "ordinal"
        },
        "y": {
          "datum": 35,
          "type": "quantitative"
        }
      },
      "name": "slopeAnnotationLeader",
      "mark": {
        "type": "rule",
        "color": "#777777",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "encoding": {
        "x": {
          "datum": "2024–25",
          "type": "ordinal"
        },
        "y": {
          "datum": 35,
          "type": "quantitative"
        }
      },
      "name": "slopeAnnotationBox",
      "mark": {
        "type": "rect",
        "fill": "#FFFFFF",
        "stroke": "#000000",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "encoding": {
        "x": {
          "datum": "2024–25",
          "type": "ordinal"
        },
        "y": {
          "datum": 35,
          "type": "quantitative"
        },
        "text": {
          "value": "Blueberries and oranges had\nnearly identical growth rates\ndespite vastly different harvest sizes."
        }
      },
      "name": "slopeAnnotationText",
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 12,
        "color": "#333333",
        "lineBreak": "\n"
      }
    }
  ],
  "width": 720,
  "height": 600,
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "labelColor": "#444444",
      "titleColor": "#222222",
      "domainColor": "#999999",
      "tickColor": "#999999",
      "labelFont": "Arial",
      "titleFont": "Arial",
      "domainWidth": 1,
      "tickWidth": 1
    },
    "font": "Arial",
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 12,
      "titleFontSize": 15
    },
    "header": {
      "labelFont": "Arial",
      "titleFont": "Arial"
    }
  }
}
