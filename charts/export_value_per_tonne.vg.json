{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Change in average export value per tonne, 2021\u20132025",
    "anchor": "start"
  },
  "width": 800,
  "height": 400,
  "data": {
    "url": "data/export_value_per_tonne.csv",
    "format": {
      "type": "csv"
    }
  },
  "usermeta": {
    "source": "Australian Horticulture Statistics Handbook 2024/25, fresh-fruit five-year comparison tables",
    "method": "Nominal fresh export value (A$ million \u00d7 1,000,000) divided by fresh export tonnes. Percentage change compares years ending June 2021 and 2025. Rounded source values yield approximate results. Bananas excluded: no recorded fresh exports."
  },
  "transform": [
    {
      "calculate": "toNumber(datum.ExportValue2021M) * 1000000 / toNumber(datum.ExportTonnes2021)",
      "as": "Value2021"
    },
    {
      "calculate": "toNumber(datum.ExportValue2025M) * 1000000 / toNumber(datum.ExportTonnes2025)",
      "as": "Value2025"
    },
    {
      "calculate": "(datum.Value2025 / datum.Value2021 - 1) * 100",
      "as": "ChangePct"
    },
    {
      "calculate": "format(datum.ChangePct, '+.1f') + '%'",
      "as": "ChangeLabel"
    },
    {
      "calculate": "datum.ChangePct >= 0 ? 'Increase' : 'Decrease'",
      "as": "Direction"
    }
  ],
  "encoding": {
    "y": {
      "field": "Fruit",
      "type": "nominal",
      "sort": {
        "field": "ChangePct",
        "order": "descending"
      },
      "title": null,
      "axis": {
        "labelPadding": 8,
        "ticks": false,
        "domain": false,
        "labelLimit": 100
      }
    },
    "x": {
      "field": "ChangePct",
      "type": "quantitative",
      "title": "Change in average export value per tonne (%)",
      "scale": {
        "domainMin": -30,
        "domainMax": {
          "expr": "width < 350 ? 160 : 115"
        },
        "nice": false
      },
      "axis": {
        "values": [
          -20,
          0,
          20,
          40,
          60,
          80,
          100
        ],
        "labelExpr": "datum.value + '%'",
        "titlePadding": 12,
        "title": [
          "Change in average export",
          "value per tonne (%)"
        ]
      }
    }
  },
  "layer": [
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#777",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "datum": 0,
          "type": "quantitative"
        },
        "y": {
          "value": 0
        },
        "y2": {
          "value": 400
        }
      }
    },
    {
      "mark": {
        "type": "bar",
        "height": 22,
        "stroke": null,
        "strokeWidth": 0
      },
      "encoding": {
        "color": {
          "field": "Direction",
          "type": "nominal",
          "title": "Direction of change",
          "scale": {
            "domain": [
              "Increase",
              "Decrease"
            ],
            "range": [
              "#006B4F",
              "#FFD500"
            ]
          },
          "legend": {
            "orient": "right",
            "symbolType": "square",
            "symbolSize": 140,
            "labelOffset": 8,
            "offset": 16,
            "titleOrient": "top",
            "titleLimit": 180,
            "titlePadding": 10,
            "symbolStrokeWidth": 0,
            "direction": "vertical"
          }
        },
        "tooltip": [
          {
            "field": "Fruit",
            "type": "nominal",
            "title": "Fruit"
          },
          {
            "field": "Value2021",
            "type": "quantitative",
            "title": "2021 average (A$/tonne)",
            "format": ",.0f"
          },
          {
            "field": "Value2025",
            "type": "quantitative",
            "title": "2025 average (A$/tonne)",
            "format": ",.0f"
          },
          {
            "field": "ChangePct",
            "type": "quantitative",
            "title": "Change (%)",
            "format": "+.1f"
          },
          {
            "field": "ExportTonnes2021",
            "type": "quantitative",
            "title": "2021 fresh exports (tonnes)",
            "format": ",.0f"
          },
          {
            "field": "ExportTonnes2025",
            "type": "quantitative",
            "title": "2025 fresh exports (tonnes)",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": {
          "expr": "datum.ChangePct < 0 && width >= 350 ? 'right' : 'left'"
        },
        "dx": {
          "expr": "datum.ChangePct < 0 ? (width < 350 ? scale('x', 0) - scale('x', datum.ChangePct) + 7 : -7) : 7"
        },
        "baseline": "middle",
        "color": "#333"
      },
      "encoding": {
        "text": {
          "field": "ChangeLabel"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "axis": {
      "gridColor": "#e6e6e6",
      "labelColor": "#444",
      "titleColor": "#222",
      "domainColor": "#999",
      "tickColor": "#999"
    }
  }
}
