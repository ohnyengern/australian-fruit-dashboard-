{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Change in export value per tonne from 2020–21 to 2024–25",
    "anchor": "start"
  },
  "width": 800,
  "height": 400,
  "data": {
    "url": "data/export_value_per_tonne.csv",
    "format": {
      "type": "csv"
    }
  },
  "usermeta": {
    "source": "Australian Horticulture Statistics Handbook 2024/25, fresh-fruit five-year comparison tables",
    "method": "Nominal fresh export value (AUD million × 1,000,000) divided by fresh export tonnes. Percentage change compares 2020–21 and 2024–25. Rounded source values yield approximate results. Bananas excluded: no recorded fresh exports."
  },
  "transform": [
    {
      "calculate": "toNumber(datum.ExportValue2021M) * 1000000 / toNumber(datum.ExportTonnes2021)",
      "as": "Value2021"
    },
    {
      "calculate": "toNumber(datum.ExportValue2025M) * 1000000 / toNumber(datum.ExportTonnes2025)",
      "as": "Value2025"
    },
    {
      "calculate": "(datum.Value2025 / datum.Value2021 - 1) * 100",
      "as": "ChangePct"
    },
    {
      "calculate": "format(datum.ChangePct, '+.1f') + '%'",
      "as": "ChangeLabel"
    },
    {
      "calculate": "datum.ChangePct >= 0 ? 'Increase' : 'Decrease'",
      "as": "Direction"
    },
    {
      "calculate": "'AUD ' + format(datum.Value2021, ',.0f')",
      "as": "Average2021Tooltip"
    },
    {
      "calculate": "'AUD ' + format(datum.Value2025, ',.0f')",
      "as": "Average2025Tooltip"
    },
    {
      "calculate": "(datum.ChangePct >= 0 ? 'Increase of ' : 'Decrease of ') + format(abs(datum.ChangePct), '.1f') + ' percent'",
      "as": "ChangeTooltip"
    },
    {
      "calculate": "format(toNumber(datum.ExportTonnes2021), ',.0f') + ' tonnes'",
      "as": "Volume2021Tooltip"
    },
    {
      "calculate": "format(toNumber(datum.ExportTonnes2025), ',.0f') + ' tonnes'",
      "as": "Volume2025Tooltip"
    }
  ],
  "encoding": {
    "y": {
      "field": "Fruit",
      "type": "nominal",
      "sort": {
        "field": "ChangePct",
        "order": "descending"
      },
      "title": null,
      "axis": {
        "labelPadding": 8,
        "ticks": false,
        "domain": false,
        "labelLimit": 100
      }
    },
    "x": {
      "field": "ChangePct",
      "type": "quantitative",
      "title": "Change in average export value per tonne (%)",
      "scale": {
        "domainMin": -30,
        "domainMax": {
          "expr": "width < 350 ? 160 : 115"
        },
        "nice": false
      },
      "axis": {
        "values": [
          -20,
          0,
          20,
          40,
          60,
          80,
          100
        ],
        "labelExpr": "datum.value + '%'",
        "titlePadding": 12,
        "title": "Change in average export value per tonne (%)"
      }
    }
  },
  "layer": [
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#777",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "datum": 0,
          "type": "quantitative"
        },
        "y": {
          "value": 0
        },
        "y2": {
          "value": 400
        }
      }
    },
    {
      "mark": {
        "type": "bar",
        "height": 22,
        "stroke": null,
        "strokeWidth": 0
      },
      "encoding": {
        "color": {
          "field": "Direction",
          "type": "nominal",
          "title": "Direction of change",
          "scale": {
            "domain": [
              "Increase",
              "Decrease"
            ],
            "range": [
              "#005C43",
              "#ff9da6"
            ]
          },
          "legend": {
            "orient": "bottom",
            "symbolType": "square",
            "symbolSize": 140,
            "labelOffset": 8,
            "offset": 24,
            "titleOrient": "left",
            "titleLimit": 180,
            "titlePadding": 20,
            "symbolStrokeWidth": 0,
            "direction": "horizontal",
            "columns": 2,
            "columnPadding": 16
          }
        },
        "tooltip": [
          {
            "field": "Fruit",
            "type": "nominal",
            "title": "Fruit:"
          },
          {
            "field": "Average2021Tooltip",
            "type": "nominal",
            "title": "Average export value per tonne in 2020–21:"
          },
          {
            "field": "Average2025Tooltip",
            "type": "nominal",
            "title": "Average export value per tonne in 2024–25:"
          },
          {
            "field": "ChangeTooltip",
            "type": "nominal",
            "title": "Change in average export value per tonne:"
          },
          {
            "field": "Volume2021Tooltip",
            "type": "nominal",
            "title": "Fresh export volume in 2020–21:"
          },
          {
            "field": "Volume2025Tooltip",
            "type": "nominal",
            "title": "Fresh export volume in 2024–25:"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "axis": {
      "gridColor": "#e6e6e6",
      "labelColor": "#444",
      "titleColor": "#222",
      "domainColor": "#999",
      "tickColor": "#999"
    },
    "legend": {
      "layout": {
        "anchor": "start"
      }
    }
  }
}
