{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Year-on-year changes in Australian fruit production",
    "fontSize": 20,
    "anchor": "start",
    "offset": 15,
    "font": "Arial"
  },
  "data": {
    "url": "https://ohnyengern.github.io/australian-fruit-dashboard-/data/abs_fruit_production.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "fold": [
        "2020–21",
        "2021–22",
        "2022–23",
        "2023–24",
        "2024–25"
      ],
      "as": [
        "Year",
        "ProductionRaw"
      ]
    },
    {
      "calculate": "toNumber(datum.ProductionRaw)",
      "as": "Production"
    },
    {
      "window": [
        {
          "op": "lag",
          "field": "Production",
          "as": "PreviousProduction"
        }
      ],
      "sort": [
        {
          "field": "Year",
          "order": "ascending"
        }
      ],
      "groupby": [
        "Fruit"
      ]
    },
    {
      "filter": "datum.PreviousProduction != null"
    },
    {
      "calculate": "((datum.Production - datum.PreviousProduction) / datum.PreviousProduction) * 100",
      "as": "YoYGrowth"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal",
          "title": "Year",
          "sort": [
            "2021–22",
            "2022–23",
            "2023–24",
            "2024–25"
          ],
          "axis": {
            "labelAngle": 0,
            "titleFontSize": 13,
            "titlePadding": 12
          }
        },
        "y": {
          "field": "Fruit",
          "type": "nominal",
          "title": null,
          "axis": {
            "labelPadding": 8
          }
        },
        "color": {
          "field": "YoYGrowth",
          "type": "quantitative",
          "title": "Annual change (%)",
          "scale": {
            "scheme": "redblue",
            "domainMid": 0
          },
          "legend": {
            "titleOrient": "top",
            "orient": "right",
            "direction": "vertical",
            "gradientLength": 300,
            "titleLimit": 180,
            "labelLimit": 80
          }
        },
        "tooltip": [
          {
            "field": "Fruit",
            "type": "nominal",
            "title": "Fruit:"
          },
          {
            "field": "Year",
            "type": "nominal",
            "title": "Year:"
          },
          {
            "field": "Production",
            "type": "quantitative",
            "title": "Production (tonnes):",
            "format": ","
          },
          {
            "field": "YoYGrowth",
            "type": "quantitative",
            "title": "Change from previous year:",
            "format": ".1f"
          }
        ]
      }
    }
  ],
  "width": 640,
  "height": 360,
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "labelColor": "#444444",
      "titleColor": "#222222",
      "domain": false,
      "ticks": false,
      "labelFont": "Arial",
      "titleFont": "Arial"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 15,
      "titleOrient": "top",
      "labelFont": "Arial",
      "titleFont": "Arial"
    },
    "font": "Arial",
    "header": {
      "labelFont": "Arial",
      "titleFont": "Arial"
    }
  },
  "usermeta": {
    "annotation": {
      "text": "Avocado production surged as newly planted trees matured and produced more fruit",
      "lines": [
        "Avocado production surged as",
        "newly planted trees matured",
        "and produced more fruit"
      ],
      "target": {
        "Fruit": "Avocado",
        "Year": "2021–22"
      },
      "source": "https://www.rabobank.com.au/news/media-releases/2022/220725-an-avo-lanche-of-avocados-australia-needs-to-consume-and-export-more-avocados"
    }
  }
}
