{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Australian fruit production from 2020–21 to 2024–25",
    "fontSize": 20,
    "anchor": "start",
    "offset": 15,
    "font": "Arial"
  },
  "data": {
    "url": "https://ohnyengern.github.io/australian-fruit-dashboard-/data/abs_fruit_production.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "fold": [
        "2020–21",
        "2021–22",
        "2022–23",
        "2023–24",
        "2024–25"
      ],
      "as": [
        "Year",
        "Production"
      ]
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal",
          "title": "Year",
          "sort": [
            "2020–21",
            "2021–22",
            "2022–23",
            "2023–24",
            "2024–25"
          ],
          "axis": {
            "labelAngle": 0,
            "grid": false,
            "titlePadding": 12
          }
        },
        "y": {
          "field": "Production",
          "type": "quantitative",
          "title": "Production (tonnes)",
          "axis": {
            "format": "~s",
            "gridColor": "#e6e6e6",
            "gridOpacity": 0.7,
            "titlePadding": 12
          }
        },
        "color": {
          "field": "Fruit",
          "type": "nominal",
          "title": "Fruit",
          "legend": {
            "titleOrient": "left",
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 8,
            "symbolType": "circle",
            "labelLimit": 120,
            "titleLimit": 160,
            "symbolFillColor": {
              "expr": "scale('color', datum.value)"
            },
            "symbolStrokeColor": {
              "expr": "scale('color', datum.value)"
            },
            "offset": 24,
            "titlePadding": 20,
            "columnPadding": 16
          },
          "scale": {
            "domain": [
              "Apple",
              "Avocado",
              "Banana",
              "Blueberry",
              "Mandarin",
              "Orange",
              "Strawberry",
              "Table grapes"
            ],
            "range": [
              "#4c78a8",
              "#f58518",
              "#A59837",
              "#72b7b2",
              "#54a24b",
              "#E0A900",
              "#b279a2",
              "#E04488"
            ]
          }
        },
        "detail": {
          "field": "Fruit"
        },
        "tooltip": [
          {
            "field": "Fruit",
            "type": "nominal",
            "title": "Fruit:"
          },
          {
            "field": "Year",
            "type": "nominal",
            "title": "Year:"
          },
          {
            "field": "Production",
            "type": "quantitative",
            "title": "Production (tonnes):",
            "format": ","
          }
        ]
      }
    }
  ],
  "width": 720,
  "height": 420,
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "labelColor": "#444",
      "titleColor": "#222",
      "domainColor": "#999",
      "tickColor": "#999",
      "labelFont": "Arial",
      "titleFont": "Arial"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 15,
      "titleOrient": "top",
      "columnPadding": 18,
      "rowPadding": 6,
      "labelFont": "Arial",
      "titleFont": "Arial",
      "layout": {
        "anchor": "start"
      }
    },
    "font": "Arial",
    "header": {
      "labelFont": "Arial",
      "titleFont": "Arial"
    }
  }
}
