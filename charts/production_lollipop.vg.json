{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Australian fruit production volume in 2024–25",
    "fontSize": 20,
    "anchor": "start",
    "offset": 15,
    "font": "Arial"
  },
  "data": {
    "url": "https://ohnyengern.github.io/australian-fruit-dashboard-/data/abs_fruit_production.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "calculate": "toNumber(datum['2025'])",
      "as": "Production"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 2,
        "color": "#8F5601",
        "opacity": 1
      },
      "encoding": {
        "y": {
          "field": "Fruit",
          "type": "nominal",
          "sort": "-x",
          "title": null
        },
        "x": {
          "field": "Production",
          "type": "quantitative",
          "title": "Production (tonnes)",
          "scale": {
            "domain": [
              0,
              700000
            ],
            "nice": false
          },
          "axis": {
            "format": "~s",
            "values": [
              0,
              100000,
              200000,
              300000,
              400000,
              500000,
              600000,
              700000
            ],
            "labelFlush": true,
            "labelOverlap": false
          }
        },
        "x2": {
          "value": 0
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 130,
        "opacity": 1
      },
      "encoding": {
        "y": {
          "field": "Fruit",
          "type": "nominal",
          "sort": "-x",
          "title": null
        },
        "x": {
          "field": "Production",
          "type": "quantitative",
          "title": "Production (tonnes)",
          "scale": {
            "domain": [
              0,
              700000
            ],
            "nice": false
          },
          "axis": {
            "format": "~s",
            "values": [
              0,
              100000,
              200000,
              300000,
              400000,
              500000,
              600000,
              700000
            ],
            "labelFlush": true,
            "labelOverlap": false
          }
        },
        "color": {
          "value": "#8F5601"
        },
        "tooltip": [
          {
            "field": "Fruit",
            "type": "nominal",
            "title": "Fruit:"
          },
          {
            "field": "Production",
            "type": "quantitative",
            "title": "Production (tonnes):",
            "format": ","
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 10,
        "fontSize": 12,
        "font": "Arial",
        "dy": 0
      },
      "encoding": {
        "y": {
          "field": "Fruit",
          "type": "nominal",
          "sort": "-x"
        },
        "x": {
          "field": "Production",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              700000
            ],
            "nice": false
          },
          "axis": {
            "format": "~s",
            "values": [
              0,
              100000,
              200000,
              300000,
              400000,
              500000,
              600000,
              700000
            ],
            "labelFlush": true,
            "labelOverlap": false
          }
        },
        "text": {
          "field": "Production",
          "type": "quantitative",
          "format": ","
        }
      }
    }
  ],
  "width": 720,
  "height": 250,
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "labelColor": "#444",
      "titleColor": "#222",
      "domainColor": "#999",
      "tickColor": "#999",
      "gridColor": "#e6e6e6",
      "gridOpacity": 0.6,
      "labelFont": "Arial",
      "titleFont": "Arial"
    },
    "font": "Arial",
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 12,
      "titleFontSize": 15
    },
    "header": {
      "labelFont": "Arial",
      "titleFont": "Arial"
    }
  }
}
