{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Which fruits drove the change in fresh-fruit export value?",
    "fontSize": 20,
    "anchor": "start",
    "offset": 15,
    "font": "Arial"
  },
  "width": 700,
  "height": 420,
  "data": {
    "url": "https://ohnyengern.github.io/australian-fruit-dashboard-/data/export_value_waterfall.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "calculate": "toNumber(datum.Order)",
      "as": "OrderNum"
    },
    {
      "calculate": "toNumber(datum.Export2021M)",
      "as": "Export2021Num"
    },
    {
      "calculate": "toNumber(datum.Export2025M)",
      "as": "Export2025Num"
    },
    {
      "calculate": "datum.Export2025Num - datum.Export2021Num",
      "as": "ChangeM"
    },
    {
      "calculate": "datum.ChangeM >= 0 ? 'Increase' : 'Decrease'",
      "as": "Type"
    },
    {
      "window": [
        {
          "op": "sum",
          "field": "ChangeM",
          "as": "EndCum"
        }
      ],
      "sort": [
        {
          "field": "OrderNum",
          "order": "ascending"
        }
      ],
      "frame": [
        null,
        0
      ]
    },
    {
      "window": [
        {
          "op": "sum",
          "field": "ChangeM",
          "as": "StartCumRaw"
        }
      ],
      "sort": [
        {
          "field": "OrderNum",
          "order": "ascending"
        }
      ],
      "frame": [
        null,
        -1
      ]
    },
    {
      "calculate": "isValid(datum.StartCumRaw) ? datum.StartCumRaw : 0",
      "as": "StartCum"
    },
    {
      "window": [
        {
          "op": "lead",
          "field": "Fruit",
          "as": "NextFruit"
        }
      ],
      "sort": [
        {
          "field": "OrderNum",
          "order": "ascending"
        }
      ]
    },
    {
      "calculate": "max(datum.StartCum, datum.EndCum)",
      "as": "LabelY"
    },
    {
      "calculate": "(datum.ChangeM >= 0 ? '+' : '-') + 'AUD ' + format(abs(datum.ChangeM), ',.1f') + ' million'",
      "as": "ChangeLabel"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar",
        "size": 55
      },
      "encoding": {
        "x": {
          "field": "Fruit",
          "type": "nominal",
          "title": null,
          "sort": {
            "field": "OrderNum",
            "order": "ascending"
          },
          "axis": {
            "labelAngle": -25,
            "labelPadding": 8,
            "labelFontSize": 12
          }
        },
        "y": {
          "field": "StartCum",
          "type": "quantitative",
          "title": "Cumulative change in fresh export value (AUD million)",
          "scale": {
            "domain": [
              0,
              370
            ]
          },
          "axis": {
            "format": ",.0f",
            "grid": true,
            "gridColor": "#e6e6e6",
            "gridOpacity": 0.7,
            "titlePadding": 12
          }
        },
        "y2": {
          "field": "EndCum"
        },
        "color": {
          "field": "Type",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Increase",
              "Decrease"
            ],
            "range": [
              "#4C9F70",
              "#D95F59"
            ]
          },
          "legend": {
            "titleOrient": "top",
            "orient": "right",
            "direction": "vertical"
          }
        },
        "tooltip": [
          {
            "field": "Fruit",
            "type": "nominal",
            "title": "Fruit:"
          },
          {
            "field": "Export2021Num",
            "type": "quantitative",
            "title": "2020–21 export value (AUD million):",
            "format": ",.1f"
          },
          {
            "field": "Export2025Num",
            "type": "quantitative",
            "title": "2024–25 export value (AUD million):",
            "format": ",.1f"
          },
          {
            "field": "ChangeM",
            "type": "quantitative",
            "title": "Change (AUD million):",
            "format": "+,.1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "isValid(datum.NextFruit)"
        }
      ],
      "mark": {
        "type": "rule",
        "stroke": "#888888",
        "strokeWidth": 1,
        "strokeDash": [
          3,
          3
        ]
      },
      "encoding": {
        "x": {
          "field": "Fruit",
          "type": "nominal",
          "sort": {
            "field": "OrderNum",
            "order": "ascending"
          }
        },
        "x2": {
          "field": "NextFruit"
        },
        "y": {
          "field": "EndCum",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "baseline": "bottom",
        "dy": -7,
        "fontSize": 12,
        "fontWeight": "bold",
        "font": "Arial"
      },
      "encoding": {
        "x": {
          "field": "Fruit",
          "type": "nominal",
          "sort": {
            "field": "OrderNum",
            "order": "ascending"
          }
        },
        "y": {
          "field": "LabelY",
          "type": "quantitative"
        },
        "text": {
          "field": "ChangeLabel"
        },
        "color": {
          "value": "#333333"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "OverallChange": 330
          }
        ]
      },
      "mark": {
        "type": "rule",
        "stroke": "#555555",
        "strokeWidth": 1.5,
        "strokeDash": [
          5,
          4
        ]
      },
      "encoding": {
        "y": {
          "field": "OverallChange",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "Fruit": "Apple",
            "OverallChange": 330,
            "Text": "Overall increase: +AUD 330.0 million"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "bottom",
        "dx": 30,
        "dy": -7,
        "fontSize": 12,
        "fontWeight": "bold",
        "font": "Arial"
      },
      "encoding": {
        "x": {
          "field": "Fruit",
          "type": "nominal"
        },
        "y": {
          "field": "OverallChange",
          "type": "quantitative"
        },
        "text": {
          "field": "Text"
        },
        "color": {
          "value": "#333333"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#444444",
      "titleColor": "#222222",
      "domainColor": "#999999",
      "tickColor": "#999999",
      "titleFontSize": 13,
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 12,
      "domainWidth": 1,
      "tickWidth": 1
    },
    "legend": {
      "titleOrient": "top",
      "labelFontSize": 12,
      "titleFontSize": 15,
      "labelFont": "Arial",
      "titleFont": "Arial"
    },
    "font": "Arial",
    "header": {
      "labelFont": "Arial",
      "titleFont": "Arial"
    }
  }
}
