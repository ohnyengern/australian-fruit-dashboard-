{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Four equal columns of faceted fruit-production maps, two rows, eight fruits.",
  "title": {
    "text": "Fruit Production Across Australian States",
    "fontSize": 20,
    "anchor": "start",
    "offset": 15,
    "font": "Arial"
  },
  "data": {
    "url": "data/fruit_state_year_small_multiples.csv",
    "format": {
      "type": "csv"
    }
  },
  "params": [
    {
      "name": "YearSelection",
      "value": 2025,
      "bind": {
        "input": "range",
        "min": 2021,
        "max": 2025,
        "step": 1,
        "name": "Year ending June: "
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.YearEnding == YearSelection"
    },
    {
      "fold": [
        "Apple",
        "Avocado",
        "Banana",
        "Blueberry",
        "Mandarin",
        "Orange",
        "Strawberry",
        "Table grapes"
      ],
      "as": [
        "Fruit",
        "Production"
      ]
    },
    {
      "lookup": "State",
      "from": {
        "data": {
          "url": "data/australia_states.json",
          "format": {
            "type": "topojson",
            "feature": "STE_2026_AUST_GDA2020"
          }
        },
        "key": "properties.STE_NAME26"
      },
      "as": "geo"
    }
  ],
  "facet": {
    "field": "Fruit",
    "type": "nominal",
    "sort": [
      "Apple",
      "Avocado",
      "Banana",
      "Blueberry",
      "Mandarin",
      "Orange",
      "Strawberry",
      "Table grapes"
    ],
    "header": {
      "title": null,
      "labelFont": "Arial",
      "labelFontSize": 12,
      "labelFontWeight": "bold",
      "labelColor": "#30251D",
      "labelOrient": "top",
      "labelAnchor": "start",
      "labelPadding": 8
    }
  },
  "columns": 4,
  "spacing": {
    "row": 60,
    "column": 0
  },
  "spec": {
    "width": 360,
    "height": 210,
    "projection": {
      "type": "mercator"
    },
    "layer": [
      {
        "transform": [],
        "mark": {
          "type": "geoshape",
          "fill": "#E6E6E6",
          "stroke": "#FFFFFF",
          "strokeWidth": 1
        },
        "encoding": {
          "shape": {
            "field": "geo",
            "type": "geojson"
          }
        }
      },
      {
        "transform": [
          {
            "filter": "isValid(datum.Production) && datum.Production > 0"
          }
        ],
        "mark": {
          "type": "circle",
          "color": "#8F5601",
          "opacity": 0.9,
          "stroke": "#FFFFFF",
          "strokeWidth": 0.5
        },
        "encoding": {
          "longitude": {
            "field": "Longitude",
            "type": "quantitative"
          },
          "latitude": {
            "field": "Latitude",
            "type": "quantitative"
          },
          "size": {
            "field": "Production",
            "type": "quantitative",
            "title": "Production (tonnes)",
            "scale": {
              "domain": [
                0,
                380000
              ],
              "range": [
                0,
                2600
              ]
            },
            "legend": {
              "title": "Production (tonnes)",
              "orient": "bottom",
              "direction": "horizontal",
              "values": [
                100000,
                200000,
                300000
              ],
              "format": ",.0f",
              "symbolType": "circle",
              "symbolFillColor": "#8F5601",
              "symbolFillOpacity": 0.7,
              "symbolStrokeColor": "#FFFFFF",
              "symbolStrokeWidth": 0.8,
              "labelFontSize": 12,
              "titleFontSize": 15,
              "titleOrient": "top",
              "offset": 10
            }
          },
          "tooltip": [
            {
              "field": "Fruit",
              "type": "nominal",
              "title": "Fruit"
            },
            {
              "field": "State",
              "type": "nominal",
              "title": "State / territory"
            },
            {
              "field": "YearEndingLabel",
              "type": "nominal",
              "title": "Year ending June"
            },
            {
              "field": "Production",
              "type": "quantitative",
              "title": "Production (tonnes)",
              "format": ",.0f"
            }
          ]
        }
      },
      {
        "transform": [
          {
            "filter": "datum.Fruit == 'Banana' && datum.State == 'Queensland'"
          },
          {
            "calculate": "133.6",
            "as": "lon"
          },
          {
            "calculate": "-37.6",
            "as": "lat"
          },
          {
            "calculate": "143.1",
            "as": "lon2"
          },
          {
            "calculate": "-25.6",
            "as": "lat2"
          }
        ],
        "mark": {
          "type": "rule",
          "stroke": "#333333",
          "strokeWidth": 1
        },
        "encoding": {
          "longitude": {
            "field": "lon",
            "type": "quantitative"
          },
          "latitude": {
            "field": "lat",
            "type": "quantitative"
          },
          "longitude2": {
            "field": "lon2"
          },
          "latitude2": {
            "field": "lat2"
          }
        }
      },
      {
        "transform": [
          {
            "filter": "datum.Fruit == 'Banana' && datum.State == 'Queensland'"
          },
          {
            "calculate": "[\"Far North Queensland\",\"dominates banana\",\"production due to its\",\"tropical climate and\",\"high rainfall\"]",
            "as": "line"
          },
          {
            "flatten": [
              "line"
            ]
          },
          {
            "calculate": "indexof([\"Far North Queensland\",\"dominates banana\",\"production due to its\",\"tropical climate and\",\"high rainfall\"], datum.line)",
            "as": "i"
          },
          {
            "calculate": "113.5",
            "as": "tlon"
          },
          {
            "calculate": "-37.8 - 1.9*datum.i",
            "as": "tlat"
          }
        ],
        "mark": {
          "type": "text",
          "align": "left",
          "baseline": "top",
          "fontSize": 12,
          "fontWeight": "normal",
          "color": "#333333",
          "font": "Arial"
        },
        "encoding": {
          "longitude": {
            "field": "tlon",
            "type": "quantitative"
          },
          "latitude": {
            "field": "tlat",
            "type": "quantitative"
          },
          "text": {
            "field": "line"
          }
        }
      },
      {
        "transform": [
          {
            "filter": "datum.Fruit == 'Apple' && datum.State == 'Victoria'"
          },
          {
            "calculate": "130.8",
            "as": "lon"
          },
          {
            "calculate": "-39.0",
            "as": "lat"
          },
          {
            "calculate": "142.6",
            "as": "lon2"
          },
          {
            "calculate": "-37.5",
            "as": "lat2"
          }
        ],
        "mark": {
          "type": "rule",
          "stroke": "#333333",
          "strokeWidth": 1
        },
        "encoding": {
          "longitude": {
            "field": "lon",
            "type": "quantitative"
          },
          "latitude": {
            "field": "lat",
            "type": "quantitative"
          },
          "longitude2": {
            "field": "lon2"
          },
          "latitude2": {
            "field": "lat2"
          }
        }
      },
      {
        "transform": [
          {
            "filter": "datum.Fruit == 'Apple' && datum.State == 'Victoria'"
          },
          {
            "calculate": "[\"Cooler southern regions\",\"drive major apple\",\"production\"]",
            "as": "line"
          },
          {
            "flatten": [
              "line"
            ]
          },
          {
            "calculate": "indexof([\"Cooler southern regions\",\"drive major apple\",\"production\"], datum.line)",
            "as": "i"
          },
          {
            "calculate": "116.2",
            "as": "tlon"
          },
          {
            "calculate": "-39.0 - 1.9*datum.i",
            "as": "tlat"
          }
        ],
        "mark": {
          "type": "text",
          "align": "left",
          "baseline": "top",
          "fontSize": 12,
          "fontWeight": "normal",
          "color": "#333333",
          "font": "Arial"
        },
        "encoding": {
          "longitude": {
            "field": "tlon",
            "type": "quantitative"
          },
          "latitude": {
            "field": "tlat",
            "type": "quantitative"
          },
          "text": {
            "field": "line"
          }
        }
      },
      {
        "transform": [
          {
            "filter": "datum.Fruit == 'Orange' && datum.State == 'New South Wales'"
          },
          {
            "calculate": "136.4",
            "as": "lon"
          },
          {
            "calculate": "-37.4",
            "as": "lat"
          },
          {
            "calculate": "142.9",
            "as": "lon2"
          },
          {
            "calculate": "-32.9",
            "as": "lat2"
          }
        ],
        "mark": {
          "type": "rule",
          "stroke": "#333333",
          "strokeWidth": 1
        },
        "encoding": {
          "longitude": {
            "field": "lon",
            "type": "quantitative"
          },
          "latitude": {
            "field": "lat",
            "type": "quantitative"
          },
          "longitude2": {
            "field": "lon2"
          },
          "latitude2": {
            "field": "lat2"
          }
        }
      },
      {
        "transform": [
          {
            "filter": "datum.Fruit == 'Orange' && datum.State == 'New South Wales'"
          },
          {
            "calculate": "[\"New South Wales leads\",\"orange production due to\",\"ideal climates and Riverina\",\"water access\"]",
            "as": "line"
          },
          {
            "flatten": [
              "line"
            ]
          },
          {
            "calculate": "indexof([\"New South Wales leads\",\"orange production due to\",\"ideal climates and Riverina\",\"water access.\"], datum.line)",
            "as": "i"
          },
          {
            "calculate": "113.5",
            "as": "tlon"
          },
          {
            "calculate": "-37.8 - 1.9*datum.i",
            "as": "tlat"
          }
        ],
        "mark": {
          "type": "text",
          "align": "left",
          "baseline": "top",
          "fontSize": 12,
          "fontWeight": "normal",
          "color": "#333333",
          "font": "Arial"
        },
        "encoding": {
          "longitude": {
            "field": "tlon",
            "type": "quantitative"
          },
          "latitude": {
            "field": "tlat",
            "type": "quantitative"
          },
          "text": {
            "field": "line"
          }
        }
      }
    ]
  },
  "resolve": {
    "scale": {
      "size": "shared"
    }
  },
  "config": {
    "view": {
      "stroke": null
    },
    "facet": {
      "spacing": 0
    },
    "header": {
      "labelFont": "Arial",
      "titleFont": "Arial"
    },
    "font": "Arial",
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 12,
      "titleFontSize": 13
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 12,
      "titleFontSize": 15
    }
  }
}
