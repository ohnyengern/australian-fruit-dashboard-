    {
      "name": "layer_3_pathgroup",
      "type": "group",
      "from": {
        "facet": {
          "name": "faceted_path_layer_3_main",
          "data": "data_0",
          "groupby": [
            "ExportTonnesNum",
            "Destination"
          ]
        }
      },
      "encode": {
        "update": {
          "width": {
            "field": {
              "group": "width"
            }
          },
          "height": {
            "field": {
              "group": "height"
            }
          }
        }
      },
      "marks": [
        {
          "name": "exportFlowArrow",
          "type": "path",
          "clip": true,
          "from": {
            "data": "exportRoute"
          },
          "encode": {
            "update": {
              "path": {
                "signal": "join(pluck(data('exportArrowOutline'), 'pathPart'), '') + 'Z'"
              },
              "fill": {
                "value": "#2450D3"
              },
              "opacity": {
                "value": 0.8
              },
              "tooltip": {
                "signal": "{\"Fruit:\": isValid(datum[\"Fruit\"]) ? datum[\"Fruit\"] : \"\"+datum[\"Fruit\"], \"Origin:\": isValid(datum[\"Origin\"]) ? datum[\"Origin\"] : \"\"+datum[\"Origin\"], \"Destination:\": isValid(datum[\"Destination\"]) ? datum[\"Destination\"] : \"\"+datum[\"Destination\"], \"Export volume (tonnes):\": format(datum[\"ExportTonnesNum\"], \",.0f\")}"
              },
              "description": {
                "signal": "\"PathLongitude: \" + (format(datum[\"PathLongitude\"], \"\")) + \"; PathLatitude: \" + (format(datum[\"PathLatitude\"], \"\")) + \"; Export volume (tonnes): \" + (format(datum[\"ExportTonnesNum\"], \"\")) + \"; PathOrder: \" + (isValid(datum[\"PathOrder\"]) ? datum[\"PathOrder\"] : \"\"+datum[\"PathOrder\"]) + \"; Destination: \" + (isValid(datum[\"Destination\"]) ? datum[\"Destination\"] : \"\"+datum[\"Destination\"]) + \"; Fruit:: \" + (isValid(datum[\"Fruit\"]) ? datum[\"Fruit\"] : \"\"+datum[\"Fruit\"]) + \"; Origin:: \" + (isValid(datum[\"Origin\"]) ? datum[\"Origin\"] : \"\"+datum[\"Origin\"]) + \"; Destination:: \" + (isValid(datum[\"Destination\"]) ? datum[\"Destination\"] : \"\"+datum[\"Destination\"]) + \"; Export volume (tonnes):: \" + (format(datum[\"ExportTonnesNum\"], \",.0f\"))"
              },
              "ariaRoleDescription": {
                "value": "export flow arrow"
              }
            }
          }
        }
      ],
      "signals": [
        {
          "name": "arrowStartX",
          "update": "length(data('exportRoutePoints')) >= 3 ? data('exportRoutePoints')[0][\"layer_3_x\"] : 0"
        },
        {
          "name": "arrowControlX",
          "update": "length(data('exportRoutePoints')) >= 3 ? data('exportRoutePoints')[1][\"layer_3_x\"] : 0"
        },
        {
          "name": "arrowEndX",
          "update": "length(data('exportRoutePoints')) >= 3 ? data('exportRoutePoints')[2][\"layer_3_x\"] : 0"
        },
        {
          "name": "arrowStartY",
          "update": "length(data('exportRoutePoints')) >= 3 ? data('exportRoutePoints')[0][\"layer_3_y\"] : 0"
        },
        {
          "name": "arrowControlY",
          "update": "length(data('exportRoutePoints')) >= 3 ? data('exportRoutePoints')[1][\"layer_3_y\"] : 0"
        },
        {
          "name": "arrowEndY",
          "update": "length(data('exportRoutePoints')) >= 3 ? data('exportRoutePoints')[2][\"layer_3_y\"] : 0"
        },
        {
          "name": "arrowThickness",
          "update": "length(data('exportRoutePoints')) ? scale('strokeWidth', data('exportRoutePoints')[0].ExportTonnesNum) : 0"
        },
        {
          "name": "arrowHeadLength",
          "update": "max(12, arrowThickness * 2)"
        },
        {
          "name": "arrowHeadWidth",
          "update": "max(8, arrowThickness * 1.9)"
        },
        {
          "name": "arrowBaseT",
          "update": "length(data('exportArrowBase')) ? data('exportArrowBase')[0].baseT : 0"
        },
        {
          "name": "arrowBaseX",
          "update": "pow(1 - (arrowBaseT), 2) * arrowStartX + 2 * (1 - (arrowBaseT)) * (arrowBaseT) * arrowControlX + pow(arrowBaseT, 2) * arrowEndX"
        },
        {
          "name": "arrowBaseY",
          "update": "pow(1 - (arrowBaseT), 2) * arrowStartY + 2 * (1 - (arrowBaseT)) * (arrowBaseT) * arrowControlY + pow(arrowBaseT, 2) * arrowEndY"
        },
        {
          "name": "arrowHeadDX",
          "update": "arrowEndX - arrowBaseX"
        },
        {
          "name": "arrowHeadDY",
          "update": "arrowEndY - arrowBaseY"
        },
        {
          "name": "arrowHeadNorm",
          "update": "sqrt(pow(arrowHeadDX, 2) + pow(arrowHeadDY, 2)) || 1"
        }
      ],
      "data": [
        {
          "name": "exportRoutePoints",
          "source": "faceted_path_layer_3_main",
          "transform": [
            {
              "type": "collect",
              "sort": {
                "field": "PathOrder"
              }
            }
          ]
        },
        {
          "name": "exportRoute",
          "source": "exportRoutePoints",
          "transform": [
            {
              "type": "filter",
              "expr": "datum.PathOrder == 0"
            }
          ]
        },
        {
          "name": "exportArrowBase",
          "transform": [
            {
              "type": "sequence",
              "start": 0,
              "stop": 201,
              "as": "sample"
            },
            {
              "type": "formula",
              "as": "t",
              "expr": "datum.sample / 200"
            },
            {
              "type": "formula",
              "as": "nextT",
              "expr": "min(1, datum.t + 1 / 200)"
            },
            {
              "type": "formula",
              "as": "x",
              "expr": "pow(1 - (datum.t), 2) * arrowStartX + 2 * (1 - (datum.t)) * (datum.t) * arrowControlX + pow(datum.t, 2) * arrowEndX"
            },
            {
              "type": "formula",
              "as": "y",
              "expr": "pow(1 - (datum.t), 2) * arrowStartY + 2 * (1 - (datum.t)) * (datum.t) * arrowControlY + pow(datum.t, 2) * arrowEndY"
            },
            {
              "type": "formula",
              "as": "nextX",
              "expr": "pow(1 - (datum.nextT), 2) * arrowStartX + 2 * (1 - (datum.nextT)) * (datum.nextT) * arrowControlX + pow(datum.nextT, 2) * arrowEndX"
            },
            {
              "type": "formula",
              "as": "nextY",
              "expr": "pow(1 - (datum.nextT), 2) * arrowStartY + 2 * (1 - (datum.nextT)) * (datum.nextT) * arrowControlY + pow(datum.nextT, 2) * arrowEndY"
            },
            {
              "type": "formula",
              "as": "segment",
              "expr": "sqrt(pow(datum.nextX - datum.x, 2) + pow(datum.nextY - datum.y, 2))"
            },
            {
              "type": "window",
              "sort": {
                "field": "sample",
                "order": "descending"
              },
              "ops": [
                "sum"
              ],
              "fields": [
                "segment"
              ],
              "as": [
                "distance"
              ],
              "frame": [
                null,
                0
              ]
            },
            {
              "type": "filter",
              "expr": "datum.segment > 0 && datum.distance >= arrowHeadLength && datum.distance - datum.segment < arrowHeadLength"
            },
            {
              "type": "formula",
              "as": "baseT",
              "expr": "(datum.sample + 1 - (arrowHeadLength - (datum.distance - datum.segment)) / datum.segment) / 200"
            }
          ]
        },
        {
          "name": "exportArrowOutline",
          "transform": [
            {
              "type": "sequence",
              "start": 0,
              "stop": 245,
              "as": "index"
            },
            {
              "type": "formula",
              "as": "t",
              "expr": "arrowBaseT * (datum.index <= 120 ? datum.index : 244 - datum.index) / 120"
            },
            {
              "type": "formula",
              "as": "x",
              "expr": "pow(1 - (datum.t), 2) * arrowStartX + 2 * (1 - (datum.t)) * (datum.t) * arrowControlX + pow(datum.t, 2) * arrowEndX"
            },
            {
              "type": "formula",
              "as": "y",
              "expr": "pow(1 - (datum.t), 2) * arrowStartY + 2 * (1 - (datum.t)) * (datum.t) * arrowControlY + pow(datum.t, 2) * arrowEndY"
            },
            {
              "type": "formula",
              "as": "dx",
              "expr": "2 * (1 - datum.t) * (arrowControlX - arrowStartX) + 2 * datum.t * (arrowEndX - arrowControlX)"
            },
            {
              "type": "formula",
              "as": "dy",
              "expr": "2 * (1 - datum.t) * (arrowControlY - arrowStartY) + 2 * datum.t * (arrowEndY - arrowControlY)"
            },
            {
              "type": "formula",
              "as": "norm",
              "expr": "sqrt(pow(datum.dx, 2) + pow(datum.dy, 2)) || 1"
            },
            {
              "type": "formula",
              "as": "side",
              "expr": "datum.index <= 120 ? 1 : -1"
            },
            {
              "type": "formula",
              "as": "outlineX",
              "expr": "datum.index == 122 ? arrowEndX : datum.index == 121 || datum.index == 123 ? arrowBaseX - arrowHeadDY / arrowHeadNorm * arrowHeadWidth / 2 * (datum.index == 121 ? 1 : -1) : datum.x - datum.dy / datum.norm * arrowThickness / 2 * datum.side"
            },
            {
              "type": "formula",
              "as": "outlineY",
              "expr": "datum.index == 122 ? arrowEndY : datum.index == 121 || datum.index == 123 ? arrowBaseY + arrowHeadDX / arrowHeadNorm * arrowHeadWidth / 2 * (datum.index == 121 ? 1 : -1) : datum.y + datum.dx / datum.norm * arrowThickness / 2 * datum.side"
            },
            {
              "type": "formula",
              "as": "pathPart",
              "expr": "(datum.index == 0 ? 'M' : 'L') + format(datum.outlineX, '.3f') + ',' + format(datum.outlineY, '.3f')"
            },
            {
              "type": "collect",
              "sort": {
                "field": "index"
              }
            }
          ]
        }
      ]
    },
