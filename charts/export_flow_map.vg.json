  "padding": 0,
  "width": 1030,
  "height": 794,
  "title": {
    "text": "Major destinations of Australian fresh-fruit exports in 2024–25",
    "fontSize": 20,
    "fontWeight": "bold",
    "anchor": "start",
    "offset": 15,
    "font": "Arial"
  },
  "style": "view",
  "data": [
    {
      "name": "source_0",
      "values": [
        {
          "type": "Sphere"
        }
      ]
    },
    {
      "name": "source_1",
      "url": "https://ohnyengern.github.io/australian-fruit-dashboard-/data/ne_110m_graticules_30.json",
      "format": {
        "type": "topojson",
        "feature": "ne_110m_graticules_30"
      }
    },
    {
      "name": "source_2",
      "url": "https://ohnyengern.github.io/australian-fruit-dashboard-/data/ne_110m_admin_0_countries.json",
      "format": {
        "type": "topojson",
        "feature": "ne_110m_admin_0_countries"
      }
    },
    {
      "name": "source_4",
      "url": "https://ohnyengern.github.io/australian-fruit-dashboard-/data/country_locations.csv",
      "format": {
        "type": "csv"
      }
    },
    {
      "name": "source_5",
      "values": [
        {
          "Origin": "Australia",
          "Longitude": 134.54588060379,
          "Latitude": -24.5710555076599,
          "Label": "Australia (origin)"
        }
      ],
      "format": {}
    },
    {
      "name": "source_3",
      "url": "https://ohnyengern.github.io/australian-fruit-dashboard-/data/hort_fruit_exports.csv",
      "format": {
        "type": "csv"
      },
      "transform": [
        {
          "type": "filter",
          "expr": "datum.Fruit == FruitSelection"
        }
      ]
    },
    {
      "name": "data_0",
      "source": "source_3",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.Destination != 'Others'"
        },
        {
          "type": "lookup",
          "from": "source_4",
          "key": "Destination",
          "fields": [
            "Destination"
          ],
          "values": [
            "Longitude",
            "Latitude"
          ],
          "as": [
            "DestinationLongitude",
            "DestinationLatitude"
          ]
        },
        {
          "type": "formula",
          "expr": "'Australia'",
          "as": "Origin"
        },
        {
          "type": "lookup",
          "from": "source_4",
          "key": "Destination",
          "fields": [
            "Origin"
          ],
          "values": [
            "Longitude",
            "Latitude"
          ],
          "as": [
            "OriginLongitude",
            "OriginLatitude"
          ]
        },
        {
          "type": "formula",
          "expr": "toNumber(datum.ExportTonnes)",
          "as": "ExportTonnesNum"
        },
        {
          "type": "formula",
          "expr": "datum.Fruit == 'Orange' && datum.Destination == 'China' ? -16 : datum.Fruit == 'Orange' && datum.Destination == 'Hong Kong' ? 0 : toNumber(datum.Bend)",
          "as": "BendNum"
        },
        {
          "type": "formula",
          "expr": "toNumber(datum.DestinationLongitude)",
          "as": "DestinationLongitudeNum"
        },
        {
          "type": "formula",
          "expr": "toNumber(datum.DestinationLatitude)",
          "as": "DestinationLatitudeNum"
        },
        {
          "type": "formula",
          "expr": "toNumber(datum.OriginLongitude)",
          "as": "OriginLongitudeNum"
        },
        {
          "type": "formula",
          "expr": "toNumber(datum.OriginLatitude)",
          "as": "OriginLatitudeNum"
        },
        {
          "type": "formula",
          "expr": "(datum.OriginLongitudeNum + datum.DestinationLongitudeNum) / 2 + datum.BendNum",
          "as": "MidLongitude"
        },
        {
          "type": "formula",
          "expr": "(datum.OriginLatitudeNum + datum.DestinationLatitudeNum) / 2",
          "as": "MidLatitude"
        },
        {
          "type": "formula",
          "expr": "[datum.OriginLongitudeNum, datum.MidLongitude, datum.DestinationLongitudeNum]",
          "as": "PathLongitude"
        },
        {
          "type": "formula",
          "expr": "[datum.OriginLatitudeNum, datum.MidLatitude, datum.DestinationLatitudeNum]",
          "as": "PathLatitude"
        },
        {
          "type": "formula",
          "expr": "[0, 1, 2]",
          "as": "PathOrder"
        },
        {
          "type": "flatten",
          "fields": [
            "PathLongitude",
            "PathLatitude",
            "PathOrder"
          ],
          "as": [
            "PathLongitude",
            "PathLatitude",
            "PathOrder"
          ]
        },
        {
          "type": "geopoint",
          "projection": "projection",
          "fields": [
            "PathLongitude",
            "PathLatitude"
          ],
          "as": [
            "layer_3_x",
            "layer_3_y"
          ]
        }
      ]
    },
    {
      "name": "data_1",
      "source": "source_3",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.Destination != 'Others' && datum.Destination != 'Singapore' && datum.Destination != 'Indonesia' && datum.Destination != 'South Korea' && datum.Destination != 'Thailand' && datum.Destination != 'New Zealand' && datum.Destination != 'United Arab Emirates' && datum.Destination != 'Philippines' && datum.Destination != 'China' && datum.Destination != 'Malaysia' && datum.Destination != 'Vietnam'"
        },
        {
          "type": "lookup",
          "from": "source_4",
          "key": "Destination",
          "fields": [
