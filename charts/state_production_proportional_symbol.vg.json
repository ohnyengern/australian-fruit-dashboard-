{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Proportional symbol map of state fruit production with fruit and year selectors.",
  "title": {
    "text": "Fruit production across Australian states",
    "fontSize": 20,
    "anchor": "start",
    "offset": 15,
    "font": "Arial"
  },
  "data": {
    "url": "https://ohnyengern.github.io/australian-fruit-dashboard-/data/fruit_state_production_by_year.csv",
    "format": {
      "type": "csv"
    }
  },
  "params": [
    {
      "name": "ProductionFruitSelection",
      "value": "Apple",
      "bind": {
        "input": "select",
        "options": [
          "Apple",
          "Avocado",
          "Banana",
          "Blueberry",
          "Mandarin",
          "Orange",
          "Strawberry",
          "Table grapes"
        ],
        "name": "Select fruit: "
      }
    },
    {
      "name": "YearSelection",
      "value": 4,
      "bind": {
        "input": "range",
        "min": 0,
        "max": 4,
        "step": 1,
        "name": "Year: "
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.YearIndex == YearSelection"
    },
    {
      "fold": [
        "Apple",
        "Avocado",
        "Banana",
        "Blueberry",
        "Mandarin",
        "Orange",
        "Strawberry",
        "Table grapes"
      ],
      "as": [
        "Fruit",
        "Production"
      ]
    },
    {
      "filter": "datum.Fruit == ProductionFruitSelection"
    },
    {
      "lookup": "State",
      "from": {
        "data": {
          "url": "https://ohnyengern.github.io/australian-fruit-dashboard-/data/australia_states.json",
          "format": {
            "type": "topojson",
            "feature": "STE_2026_AUST_GDA2020"
          }
        },
        "key": "properties.STE_NAME26"
      },
      "as": "geo"
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 12,
      "titleFontSize": 13
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 12,
      "titleFontSize": 15
    }
  },
  "width": 720,
  "height": 460,
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "transform": [],
      "mark": {
        "type": "geoshape",
        "fill": "#E6E6E6",
        "stroke": "#FFFFFF",
        "strokeWidth": 1
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        }
      }
    },
    {
      "name": "appleAnnotationLeader",
      "transform": [
        {
          "filter": "datum.Fruit == 'Apple' && datum.State == 'Victoria'"
        },
        {
          "calculate": "132",
          "as": "NoteLongitude"
        },
        {
          "calculate": "-40",
          "as": "NoteLatitude"
        }
      ],
      "mark": {
        "type": "rule",
        "stroke": "#61564f",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "NoteLongitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "NoteLatitude",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "Longitude"
        },
        "latitude2": {
          "field": "Latitude"
        }
      }
    },
    {
      "name": "bananaAnnotationLeader",
      "transform": [
        {
          "filter": "datum.Fruit == 'Banana' && datum.State == 'Queensland'"
        },
        {
          "calculate": "152",
          "as": "NoteLongitude"
        },
        {
          "calculate": "-17",
          "as": "NoteLatitude"
        }
      ],
      "mark": {
        "type": "rule",
        "stroke": "#61564f",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "NoteLongitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "NoteLatitude",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "Longitude"
        },
        "latitude2": {
          "field": "Latitude"
        }
      }
    },
    {
      "name": "orangeAnnotationLeader",
      "transform": [
        {
          "filter": "datum.Fruit == 'Orange' && datum.State == 'New South Wales'"
        },
        {
          "calculate": "128",
          "as": "NoteLongitude"
        },
        {
          "calculate": "-40.5",
          "as": "NoteLatitude"
        }
      ],
      "mark": {
        "type": "rule",
        "stroke": "#61564f",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "NoteLongitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "NoteLatitude",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "Longitude"
        },
        "latitude2": {
          "field": "Latitude"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "isValid(datum.Production) && datum.Production > 0"
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#8F5601",
        "opacity": 0.9,
        "stroke": "#FFFFFF",
        "strokeWidth": 0.5
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "Production",
          "type": "quantitative",
          "title": "Production (tonnes)",
          "scale": {
            "domain": [
              0,
              380000
            ],
            "range": [
              0,
              2600
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "Fruit",
            "type": "nominal",
            "title": "Fruit:"
          },
          {
            "field": "State",
            "type": "nominal",
            "title": "State / territory:"
          },
          {
            "field": "Year",
            "type": "nominal",
            "title": "Year:"
          },
          {
            "field": "Production",
            "type": "quantitative",
            "title": "Production (tonnes):",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "name": "appleAnnotationBackground",
      "transform": [
        {
          "filter": "datum.Fruit == 'Apple' && datum.State == 'Victoria'"
        },
        {
          "calculate": "132",
          "as": "NoteLongitude"
        },
        {
          "calculate": "-40",
          "as": "NoteLatitude"
        }
      ],
      "mark": {
        "type": "rect",
        "width": 228,
        "height": 72,
        "fill": "#FFF2D6",
        "stroke": null
      },
      "encoding": {
        "longitude": {
          "field": "NoteLongitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "NoteLatitude",
          "type": "quantitative"
        }
      }
    },
    {
      "name": "appleAnnotationText",
      "transform": [
        {
          "filter": "datum.Fruit == 'Apple' && datum.State == 'Victoria'"
        },
        {
          "calculate": "132",
          "as": "NoteLongitude"
        },
        {
          "calculate": "-40",
          "as": "NoteLatitude"
        },
        {
          "calculate": "[\"Cooler southern regions\", \"support major apple\", \"production\"]",
          "as": "NoteLines"
        },
        {
          "flatten": [
            "NoteLines"
          ],
          "as": [
            "NoteLine"
          ]
        },
        {
          "calculate": "indexof([\"Cooler southern regions\", \"support major apple\", \"production\"], datum.NoteLine)",
          "as": "NoteLineIndex"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "dx": 12,
        "dy": {
          "expr": "12 + datum.NoteLineIndex * 16"
        },
        "font": "Arial",
        "fontSize": 12,
        "color": "#333333"
      },
      "encoding": {
        "longitude": {
          "field": "NoteLongitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "NoteLatitude",
          "type": "quantitative"
        },
        "text": {
          "field": "NoteLine"
        }
      }
    },
    {
      "name": "bananaAnnotationBackground",
      "transform": [
        {
          "filter": "datum.Fruit == 'Banana' && datum.State == 'Queensland'"
        },
        {
          "calculate": "152",
          "as": "NoteLongitude"
        },
        {
          "calculate": "-17",
          "as": "NoteLatitude"
        }
      ],
      "mark": {
        "type": "rect",
        "width": 228,
        "height": 72,
        "fill": "#FFF2D6",
        "stroke": null
      },
      "encoding": {
        "longitude": {
          "field": "NoteLongitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "NoteLatitude",
          "type": "quantitative"
        }
      }
    },
    {
      "name": "bananaAnnotationText",
      "transform": [
        {
          "filter": "datum.Fruit == 'Banana' && datum.State == 'Queensland'"
        },
        {
          "calculate": "152",
          "as": "NoteLongitude"
        },
        {
          "calculate": "-17",
          "as": "NoteLatitude"
        },
        {
          "calculate": "[\"Queensland dominates banana\", \"production, supported by\", \"tropical climates and rainfall\"]",
          "as": "NoteLines"
        },
        {
          "flatten": [
            "NoteLines"
          ],
          "as": [
            "NoteLine"
          ]
        },
        {
          "calculate": "indexof([\"Queensland dominates banana\", \"production, supported by\", \"tropical climates and rainfall\"], datum.NoteLine)",
          "as": "NoteLineIndex"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "dx": 12,
        "dy": {
          "expr": "12 + datum.NoteLineIndex * 16"
        },
        "font": "Arial",
        "fontSize": 12,
        "color": "#333333"
      },
      "encoding": {
        "longitude": {
          "field": "NoteLongitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "NoteLatitude",
          "type": "quantitative"
        },
        "text": {
          "field": "NoteLine"
        }
      }
    },
    {
      "name": "orangeAnnotationBackground",
      "transform": [
        {
          "filter": "datum.Fruit == 'Orange' && datum.State == 'New South Wales'"
        },
        {
          "calculate": "128",
          "as": "NoteLongitude"
        },
        {
          "calculate": "-40.5",
          "as": "NoteLatitude"
        }
      ],
      "mark": {
        "type": "rect",
        "width": 228,
        "height": 72,
        "fill": "#FFF2D6",
        "stroke": null
      },
      "encoding": {
        "longitude": {
          "field": "NoteLongitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "NoteLatitude",
          "type": "quantitative"
        }
      }
    },
    {
      "name": "orangeAnnotationText",
      "transform": [
        {
          "filter": "datum.Fruit == 'Orange' && datum.State == 'New South Wales'"
        },
        {
          "calculate": "128",
          "as": "NoteLongitude"
        },
        {
          "calculate": "-40.5",
          "as": "NoteLatitude"
        },
        {
          "calculate": "[\"New South Wales leads\", \"orange production, supported\", \"by Riverina water access\"]",
          "as": "NoteLines"
        },
        {
          "flatten": [
            "NoteLines"
          ],
          "as": [
            "NoteLine"
          ]
        },
        {
          "calculate": "indexof([\"New South Wales leads\", \"orange production, supported\", \"by Riverina water access\"], datum.NoteLine)",
          "as": "NoteLineIndex"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "dx": 12,
        "dy": {
          "expr": "12 + datum.NoteLineIndex * 16"
        },
        "font": "Arial",
        "fontSize": 12,
        "color": "#333333"
      },
      "encoding": {
        "longitude": {
          "field": "NoteLongitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "NoteLatitude",
          "type": "quantitative"
        },
        "text": {
          "field": "NoteLine"
        }
      }
    }
  ],
  "usermeta": {
    "stateLabels": [
      {
        "name": "Western Australia",
        "lines": [
          "Western",
          "Australia"
        ],
        "longitude": 121.5,
        "latitude": -22
      },
      {
        "name": "Northern Territory",
        "lines": [
          "Northern",
          "Territory"
        ],
        "longitude": 133.5,
        "latitude": -16
      },
      {
        "name": "South Australia",
        "lines": [
          "South Australia"
        ],
        "longitude": 135.5,
        "latitude": -27.3
      },
      {
        "name": "Queensland",
        "lines": [
          "Queensland"
        ],
        "longitude": 145,
        "latitude": -25.3
      },
      {
        "name": "New South Wales",
        "lines": [
          "New South Wales"
        ],
        "longitude": 147,
        "latitude": -29.9
      },
      {
        "name": "Australian Capital Territory",
        "lines": [
          "Australian",
          "Capital Territory"
        ],
        "longitude": 151.5,
        "latitude": -35.28,
        "anchorLongitude": 149.13,
        "anchorLatitude": -35.28
      },
      {
        "name": "Victoria",
        "lines": [
          "Victoria"
        ],
        "longitude": 151.5,
        "latitude": -38.1,
        "anchorLongitude": 147.52,
        "anchorLatitude": -38.1
      },
      {
        "name": "Tasmania",
        "lines": [
          "Tasmania"
        ],
        "longitude": 151.5,
        "latitude": -42.5,
        "anchorLongitude": 147.97,
        "anchorLatitude": -42.5
      }
    ]
  }
}
