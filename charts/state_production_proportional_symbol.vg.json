
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Proportional symbol map of state fruit production with fruit and year selectors.",
  "title": {
    "text": "Fruit production across Australian states",
    "fontSize": 20,
    "anchor": "start",
    "offset": 15,
    "font": "Arial"
  },
  "data": {
    "url": "https://ohnyengern.github.io/australian-fruit-dashboard-/data/fruit_state_production_by_year.csv",
    "format": {
      "type": "csv"
    }
  },
  "params": [
    {
      "name": "ProductionFruitSelection",
      "value": "Apple",
      "bind": {
        "input": "select",
        "options": [
          "Apple",
          "Avocado",
          "Banana",
          "Blueberry",
          "Mandarin",
          "Orange",
          "Strawberry",
          "Table grapes"
        ],
        "name": "Select fruit: "
      }
    },
    {
      "name": "YearSelection",
      "value": 2024,
      "bind": {
        "input": "range",
        "min": 2020,
        "max": 2024,
        "step": 1,
        "name": "Year: "
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 12,
      "titleFontSize": 13
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 12,
      "titleFontSize": 15
    }
  },
  "width": 720,
  "height": 500,
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "name": "stateBoundaries",
      "data": {
        "url": "https://ohnyengern.github.io/australian-fruit-dashboard-/data/australia_states.json",
        "format": {
          "type": "topojson",
          "feature": "STE_2026_AUST_GDA2020"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#E6E6E6",
        "stroke": "#FFFFFF",
        "strokeWidth": 1
      }
    },
    {
      "name": "appleAnnotationLeader",
      "transform": [
        {
          "filter": "parseInt(datum.Year) == YearSelection"
        },
        {
          "fold": [
            "Apple",
            "Avocado",
            "Banana",
            "Blueberry",
            "Mandarin",
            "Orange",
            "Strawberry",
            "Table grapes"
          ],
          "as": ["Fruit", "Production"]
        },
        {
          "filter": "datum.Fruit == ProductionFruitSelection"
        },
        {
          "filter": "datum.Fruit == 'Apple' && datum.State == 'Victoria'"
        },
        {
          "calculate": "130.8",
          "as": "NoteLongitude"
        },
        {
          "calculate": "-40",
          "as": "NoteLatitude"
        }
      ],
      "mark": {
        "type": "rule",
        "stroke": "#61564f",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "NoteLongitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "NoteLatitude",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "Longitude"
        },
        "latitude2": {
          "field": "Latitude"
        }
      }
    },
    {
      "name": "bananaAnnotationLeader",
      "transform": [
        {
          "filter": "parseInt(datum.Year) == YearSelection"
        },
        {
          "fold": [
            "Apple",
            "Avocado",
            "Banana",
            "Blueberry",
            "Mandarin",
            "Orange",
            "Strawberry",
            "Table grapes"
          ],
          "as": ["Fruit", "Production"]
        },
        {
          "filter": "datum.Fruit == ProductionFruitSelection"
        },
        {
          "filter": "datum.Fruit == 'Banana' && datum.State == 'Queensland'"
        },
        {
          "calculate": "155",
          "as": "NoteLongitude"
        },
        {
          "calculate": "-13",
          "as": "NoteLatitude"
        }
      ],
      "mark": {
        "type": "rule",
        "stroke": "#61564f",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "NoteLongitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "NoteLatitude",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "Longitude"
        },
        "latitude2": {
          "field": "Latitude"
        }
      }
    },
    {
      "name": "orangeAnnotationLeader",
      "transform": [
        {
          "filter": "parseInt(datum.Year) == YearSelection"
        },
        {
          "fold": [
            "Apple",
            "Avocado",
            "Banana",
            "Blueberry",
            "Mandarin",
            "Orange",
            "Strawberry",
            "Table grapes"
          ],
          "as": ["Fruit", "Production"]
        },
        {
          "filter": "datum.Fruit == ProductionFruitSelection"
        },
        {
          "filter": "datum.Fruit == 'Orange' && datum.State == 'New South Wales'"
        },
        {
          "calculate": "121",
          "as": "NoteLongitude"
        },
        {
          "calculate": "-36",
          "as": "NoteLatitude"
        }
      ],
      "mark": {
        "type": "rule",
        "stroke": "#61564f",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "NoteLongitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "NoteLatitude",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "Longitude"
        },
        "latitude2": {
          "field": "Latitude"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "parseInt(datum.Year) == YearSelection"
        },
        {
          "fold": [
            "Apple",
            "Avocado",
            "Banana",
            "Blueberry",
            "Mandarin",
            "Orange",
            "Strawberry",
            "Table grapes"
          ],
          "as": ["Fruit", "Production"]
        },
        {
          "filter": "datum.Fruit == ProductionFruitSelection"
        },
        {
          "filter": "isValid(datum.Production) && datum.Production > 0"
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#B8D986",
        "opacity": 1,
        "stroke": null,
        "strokeWidth": 0
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "Production",
          "type": "quantitative",
          "title": "Production (tonnes)",
          "scale": {
            "domain": [0, 380000],
            "range": [0, 2600]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "Fruit",
            "type": "nominal",
            "title": "Fruit:"
          },
          {
            "field": "State",
            "type": "nominal",
            "title": "State / territory:"
          },
          {
            "field": "Year",
            "type": "nominal",
            "title": "Year:"
          },
          {
            "field": "Production",
            "type": "quantitative",
            "title": "Production (tonnes):",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "name": "appleAnnotationBackground",
      "transform": [
        {
          "filter": "parseInt(datum.Year) == YearSelection"
        },
        {
          "fold": [
            "Apple",
            "Avocado",
            "Banana",
            "Blueberry",
            "Mandarin",
            "Orange",
            "Strawberry",
            "Table grapes"
          ],
          "as": ["Fruit", "Production"]
        },
        {
          "filter": "datum.Fruit == ProductionFruitSelection"
        },
        {
          "filter": "datum.Fruit == 'Apple' && datum.State == 'Victoria'"
        },
        {
          "calculate": "130.8",
          "as": "NoteLongitude"
        },
        {
          "calculate": "-40",
          "as": "NoteLatitude"
        }
      ],
      "mark": {
        "type": "rect",
        "width": 228,
        "height": 72,
        "fill": "#FFFFFF",
        "stroke": "#000000",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "NoteLongitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "NoteLatitude",
          "type": "quantitative"
        }
      }
    },
    {
      "name": "appleAnnotationText",
      "transform": [
        {
          "filter": "parseInt(datum.Year) == YearSelection"
        },
        {
          "fold": [
            "Apple",
            "Avocado",
            "Banana",
            "Blueberry",
            "Mandarin",
            "Orange",
            "Strawberry",
            "Table grapes"
          ],
          "as": ["Fruit", "Production"]
        },
        {
          "filter": "datum.Fruit == ProductionFruitSelection"
        },
        {
          "filter": "datum.Fruit == 'Apple' && datum.State == 'Victoria'"
        },
        {
          "calculate": "130.8",
          "as": "NoteLongitude"
        },
        {
          "calculate": "-40",
          "as": "NoteLatitude"
        },
        {
          "calculate": "[\"Cooler southern regions\", \"support major apple\", \"production\"]",
          "as": "NoteLines"
        },
        {
          "flatten": ["NoteLines"],
          "as": ["NoteLine"]
        },
        {
          "calculate": "indexof([\"Cooler southern regions\", \"support major apple\", \"production\"], datum.NoteLine)",
          "as": "NoteLineIndex"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "dx": 12,
        "dy": {
          "expr": "12 + datum.NoteLineIndex * 16"
        },
        "font": "Arial",
        "fontSize": 12,
        "color": "#333333"
      },
      "encoding": {
        "longitude": {
          "field": "NoteLongitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "NoteLatitude",
          "type": "quantitative"
        },
        "text": {
          "field": "NoteLine"
        }
      }
    },
    {
      "name": "bananaAnnotationBackground",
      "transform": [
        {
          "filter": "parseInt(datum.Year) == YearSelection"
        },
        {
          "fold": [
            "Apple",
